# Development
# See https://developers.cloudflare.com/turnstile/troubleshooting/testing/
VITE_TURNSTILE_FORM_KEY=""
VITE_TOLGEE_API_KEY=""

# QA Translations: set to 'true' to use *-qa language files and /qa/ data paths
# When true: uses es-qa, qu-qa, ay-qa languages and fetches data from /qa/ bucket path
# When false/unset: uses es, qu, ay languages and fetches data from production bucket path
VITE_TOLGEE_QA_TRANSLATIONS=true

# Branding: set to 'false' to always use neutral branding
# VITE_USE_ELECTION_BRANDING=false

# Local JSON processing: set to 'true' to use JSON files in "public/" (development only)
# VITE_USE_LOCAL_DATA = false

# Wrangler
CLOUDFLARE_ENV=qa

# Analytics
VITE_TRENCH_ENABLED=false