# Trench (Analytics)
VITE_TRENCH_ENABLED=true
VITE_TRENCH_SERVER_URL=
VITE_TRENCH_PUBLIC_API_KEY=

# Cloudflare Turnstile (DEMO/PROD)
VITE_TURNSTILE_FORM_KEY=

# hCaptcha (fallback for older browsers that can't run Turnstile)
VITE_HCAPTCHA_SITE_KEY=

# Fallback API for hCaptcha submissions
VITE_HCAPTCHA_FALLBACK_API=

# i18n (should NOT be present in PROD)
# VITE_TOLGEE_API_URL=
# DEMO OR PROD (read-only)
# VITE_TOLGEE_API_KEY=

# External data
VITE_I18N_URL=
VITE_ELECTIONS_DATA_URL=

# Election & Branding
# Controls which elections are available:
# - Single ID: single-election mode (skips selector, auto-selects that election)
#   VITE_ELECTION_ID=peru_2026
# - Multiple IDs (comma-separated): multi-election mode with only these elections
#   VITE_ELECTION_ID=peru_2026,chile_2025
# - Empty/not set: all elections with enabled:true in their config
# VITE_ELECTION_ID=peru_2026

# Set to 'false' to keep neutral branding throughout session (even after election selected)
# Default: true (use election-specific branding once user selects an election)
VITE_USE_ELECTION_BRANDING=true

# Intro Screens
# Generic intro: shown before election selection (neutral branding)
# Default: true in multi-election mode, false when VITE_ELECTION_ID is set
# VITE_SHOW_GENERIC_INTRO=true

# Election intro: shown after election is selected, before quiz starts
# Can also be controlled per-election via showIntro in election config
# Default: true
# VITE_SHOW_ELECTION_INTRO=true
