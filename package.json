{
  "name": "electometro",
  "homepage": "https://electometro.org",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "build-dev": "vite build --mode development",
    "build": "vite build",
    "prepare": "lefthook install",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "preview": "npm run build-dev && wrangler dev --local-protocol https",
    "preview-qa": "CLOUDFLARE_ENV=qa npm run build-dev && wrangler dev --local-protocol https",
    "deploy": "npm run build && wrangler deploy",
    "deploy-qa": "CLOUDFLARE_ENV=qa npm run build && wrangler deploy"
  },
  "dependencies": {
    "@tolgee/react": "^6.2.7",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fpscanner": "^1.0.1",
    "mongoose": "^8.12.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^2.2.2",
    "react-router-dom": "^7.2.0",
    "trench-js": "^0.0.17"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.15.2",
    "@cloudflare/workers-types": "^4.20251121.0",
    "@eslint/js": "^9.21.0",
    "@ljharb/tsconfig": "^0.3.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-legacy": "^6.1.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "gh-pages": "^6.3.0",
    "globals": "^15.15.0",
    "lefthook": "^1.12.2",
    "terser": "^5.46.0",
    "vite": "^6.4.1",
    "vite-plugin-terminal": "^1.4.0",
    "vitest": "^4.1.9",
    "wrangler": "^4.58.0"
  },
  "description": "Electómetro: Voting Alignment WebApp, using Vite HMR and some ESLint rules.",
  "main": "eslint.config.js",
  "keywords": [
    "voting-advice-application",
    "vaa",
    "civic-tech",
    "elections",
    "democracy",
    "electoral-technology",
    "political-alignment",
    "voter-education",
    "informed-voting"
  ],
  "author": "Electómetro contributors",
  "contributors": [
    "José Valqui",
    "Fernando Saba"
  ],
  "license": "Apache-2.0",
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "Chrome >= 70",
    "Firefox >= 68",
    "Safari >= 12",
    "iOS >= 12",
    "Edge >= 79",
    "not dead"
  ]
}
